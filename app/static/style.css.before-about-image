:root{--ink:#152c2b;--muted:#59706a;--cream:#f6f6ef;--green:#d2f17a;--line:#d6dbce}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font:16px/1.55 system-ui,-apple-system,Segoe UI,sans-serif}a{color:inherit;text-decoration:none}h1,h2,h3,p{margin-top:0}h1,h2{letter-spacing:-.065em;line-height:1.05}h1{font-size:clamp(4rem,8vw,8.6rem)}h2{font-size:clamp(3rem,5.5vw,6rem)}h3{font-size:1.5rem;letter-spacing:-.04em}em{color:#668d42;font-style:normal}button,input,textarea,select{font:inherit}.nav{padding:26px clamp(24px,6vw,100px);display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);gap:20px}.brand{display:flex;align-items:center;gap:12px;font-weight:900;letter-spacing:-.05em;font-size:25px}.brand-dot{color:#7f9f47;margin-left:-12px}.brand span:last-child{font-size:12px;letter-spacing:0;font-weight:600;color:var(--muted);margin-left:8px}.nav nav{display:flex;align-items:center;gap:32px;font-size:13px;font-weight:650}.nav-button{border:1px solid var(--ink);padding:11px 17px;border-radius:50px}.hero{min-height:710px;position:relative;overflow:hidden;padding:110px clamp(24px,9vw,160px) 30px}.eyebrow{font-size:12px;letter-spacing:.19em;font-weight:800;margin-bottom:28px}.pulse{display:inline-block;background:#7d9f40;width:9px;height:9px;border-radius:50%;margin-right:9px}.hero h1{position:relative;z-index:1;margin-bottom:30px}.lead{position:relative;z-index:1;max-width:590px;color:var(--muted);font-size:20px}.actions{position:relative;z-index:1;display:flex;gap:12px;margin-top:38px}.button{display:inline-flex;align-items:center;gap:26px;padding:15px 25px;border-radius:100px;font-size:14px;font-weight:800;cursor:pointer;border:none}.primary{background:var(--ink);color:white}.outline{border:1px solid var(--ink)}.hero-bottom{position:relative;z-index:1;border-top:1px solid var(--line);margin-top:90px;padding-top:24px;display:flex;gap:55px}.hero-bottom div{display:flex;gap:12px;font-size:12px}.hero-bottom strong{font-size:13px}.hero-bottom span{color:var(--muted)}.decoration{position:absolute;right:-150px;top:70px;height:580px;width:580px;opacity:.48;pointer-events:none}.orbit{position:absolute;border:1px solid #bdcbab;border-radius:50%;inset:0}.orbit.two{inset:65px}.core{position:absolute;inset:150px;border-radius:50%;display:grid;place-items:center;background:#e8f0d5;font-size:64px;color:#8ca26c;font-weight:900}.section{padding:110px clamp(24px,9vw,160px)}.section-heading{max-width:850px;margin-bottom:50px}.section-heading>p:last-child{color:var(--muted);font-size:18px;max-width:550px}.service-grid{display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.service{border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:38px;min-height:300px}.symbol{float:right;font-size:33px;color:#739b41}.number{font-size:12px;font-weight:800;letter-spacing:.17em;color:var(--muted);margin-bottom:48px}.service h3{margin-bottom:14px}.service>p:not(.number){color:var(--muted);max-width:410px}.service>span{font-size:12px;font-weight:750;color:#678b44}.dark{background:var(--ink);color:white}.dark em{color:var(--green)}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:40px}.steps>div{border-top:1px solid #4c6760;padding-top:22px}.steps b{color:var(--green)}.steps h3{margin:48px 0 12px}.steps p{color:#aabbb4}.about{max-width:1100px}.about>p:not(.eyebrow){font-size:20px;color:var(--muted);max-width:750px}.text-link{font-weight:800;border-bottom:1px solid var(--ink);padding-bottom:6px}.contact{background:#eaf0de;display:grid;grid-template-columns:1fr 1fr;gap:80px}.contact-copy>p:not(.eyebrow){font-size:18px;color:var(--muted)}.contact-copy>a{font-weight:750;text-decoration:underline}.contact-form{background:#fff;padding:40px;border-radius:5px;display:grid;gap:18px}.contact-form label{font-weight:700;font-size:13px;display:grid;gap:7px}.contact-form input,.contact-form select,.contact-form textarea{width:100%;border:1px solid #d6ddd5;border-radius:4px;padding:12px;background:#fbfcf9;color:var(--ink);outline-offset:2px}.contact-form small{font-size:12px;color:var(--muted)}.trap{position:absolute;left:-9999px}footer{display:flex;justify-content:space-between;gap:20px;background:var(--ink);color:#bbc9c2;padding:30px clamp(24px,9vw,160px);font-size:12px}.confirmation{min-height:100vh;padding:15vh 10vw}.confirmation p:not(.eyebrow){max-width:600px;color:var(--muted);font-size:20px}.admin{padding:60px 4vw}.admin h1{font-size:60px}.table-wrap{overflow-x:auto}table{border-collapse:collapse;width:100%;background:white;font-size:13px}th,td{border:1px solid #d9ded5;padding:14px;text-align:left;vertical-align:top;min-width:110px;overflow-wrap:anywhere}th{background:#dce9cf}td:last-child{min-width:270px}@media(max-width:900px){.nav nav a:not(.nav-button){display:none}.hero{padding-top:80px;min-height:auto}.decoration{opacity:.12}.hero-bottom{gap:20px;flex-wrap:wrap}.contact{grid-template-columns:1fr;gap:24px}.steps{grid-template-columns:1fr}.steps h3{margin:20px 0 12px}}@media(max-width:600px){.nav{padding:18px 22px}.brand span:last-child{display:none}.hero{padding:65px 24px 35px}.hero h1{font-size:clamp(3.6rem,14vw,6rem)}.hero-bottom{margin-top:65px}.section{padding:75px 24px}.service-grid{grid-template-columns:1fr}.service{padding:25px;min-height:260px}.contact-form{padding:22px}.actions{flex-wrap:wrap}footer{flex-direction:column}}

/* Business agency imagery — visual update 2026-10-29 */
.hero{display:flex;flex-direction:column;align-items:flex-start;min-height:750px;padding-right:49%}
.hero h1{font-size:clamp(3.7rem,6vw,7.2rem);white-space:nowrap}
.hero-visual{position:absolute;right:0;top:0;width:47%;height:100%;overflow:hidden;border-bottom-left-radius:90px;background:#dce6d7}
.hero-visual::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(21,44,43,.08),transparent 45%);pointer-events:none}
.hero-visual img{width:100%;height:100%;object-fit:cover;object-position:45% center;display:block}
.hero-bottom{margin-top:auto;width:100%;gap:20px;flex-wrap:wrap}
.hero-bottom div{flex-direction:column;gap:2px}
.service-with-image{padding-top:0}
.service-photo{display:block;width:calc(100% + 76px);height:210px;max-width:none;margin:0 -38px 30px;object-fit:cover;object-position:center}
.service-with-image .number{margin-bottom:28px}
@media(max-width:1150px){.hero{padding-right:44%}.hero-visual{width:42%}.hero h1{font-size:clamp(3.2rem,5.6vw,6rem)}}
@media(max-width:900px){.hero{display:block;padding-right:24px;min-height:auto}.hero h1{white-space:normal}.hero-visual{position:relative;width:100%;height:340px;margin:45px 0 0;border-radius:22px}.hero-bottom{margin-top:40px}}
@media(max-width:600px){.hero-visual{height:250px}.service-photo{height:185px;width:calc(100% + 50px);margin:0 -25px 25px}}
